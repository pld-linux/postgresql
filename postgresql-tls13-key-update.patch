TLS 1.3 has no renegotiation: with ssl_renegotiation_limit > 0 every TLS 1.3
connection is killed once the limit is reached.  Use a key update instead.

diff -urNp postgresql-9.3.25.orig/src/backend/libpq/be-secure.c postgresql-9.3.25/src/backend/libpq/be-secure.c
--- postgresql-9.3.25.orig/src/backend/libpq/be-secure.c
+++ postgresql-9.3.25/src/backend/libpq/be-secure.c
@@ -339,6 +339,21 @@ secure_write(Port *port, void *ptr, size
 		 * progress.  Request the renegotiation 1kB before the limit has
 		 * actually expired.
 		 */
+#ifdef TLS1_3_VERSION
+		if (ssl_renegotiation_limit &&
+			port->count > (ssl_renegotiation_limit - 1) * 1024L &&
+			SSL_version(port->ssl) >= TLS1_3_VERSION)
+		{
+			/*
+			 * TLS 1.3 has no renegotiation; a key update renews the traffic
+			 * keys in both directions.  If one is still pending, retry on
+			 * the next write.
+			 */
+			if (SSL_key_update(port->ssl, SSL_KEY_UPDATE_REQUESTED) == 1)
+				port->count = 0;
+		}
+		else
+#endif
 		if (ssl_renegotiation_limit && !in_ssl_renegotiation &&
 			port->count > (ssl_renegotiation_limit - 1) * 1024L)
 		{
